{
    "name": "neotiler/flarum-drawer-tags",
    "description": "Neo Mobile Tag Drawer: Moves tags to the mobile navigation drawer for a cleaner and more accessible experience.",
    "homepage": "https://getneotiler.com",
    "keywords": ["flarum", "tags", "drawer", "navigation", "mobile", "neo"],
    "type": "flarum-extension",
    "license": "MIT",
    "require": {
        "flarum/core": "^1.0 || ^2.0",
        "flarum/tags": "*"
    },
    "authors": [
        {
            "name": "NeoTiler",
            "homepage": "https://getneotiler.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "NeoTiler\\DrawerTags\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Neo Mobile Tag Drawer",
            "icon": {
                "name": "fas fa-bars",
                "backgroundColor": "#4a90d9",
                "color": "#fff"
            }
        }
    }
}
